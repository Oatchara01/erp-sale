; คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าของเครื่องนั้น ๆ
; ถ้ารหัสผ่านมีอักขระพิเศษ ให้ครอบด้วยเครื่องหมายคำพูด

; ค่าร่วมของทุกฐานข้อมูล
DB_HOST=
DB_USER=
DB_PASS=

; ชื่อฐานข้อมูลของแต่ละไฟล์ dbconnect*.php
DB_NAME=
DB_STOCK_NAME=
DB_SALE_NAME=
DB_CS_NAME=
DB_ACC_NAME=
DB_SERVICE_NAME=
DB_INTER_NAME=

; ฐานข้อมูลไหนใช้ host/user/รหัสผ่านต่างจากค่าร่วม ให้ตั้ง DB_<ชื่อ>_HOST / _USER / _PASS เพิ่ม เช่น
;DB_INTER_USER=
;DB_INTER_PASS=
